# Local Supabase (from `supabase status`). For a hosted project, swap in your
# project URL + keys. NEVER commit real production keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (used by /api/reconcile). Do not prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
